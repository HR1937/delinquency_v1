# ─────────────────────────────────────────────────────────────────────────────
# EARLY DELINQUENCY AI — MORTGAGE SERVICING VOICE OPERATIONS CONSOLE
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ─────────────────────────────────────────────────────────────────────────────

# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (localhost:5432 or managed instance)
DATABASE_URL=postgresql://postgres:password@localhost:5432/delinquency_poc

# ─── VAPI VOICE PLATFORM (Server-side credentials) ───────────────────────────
VAPI_PRIVATE_API_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_SIP_URI=sip:your_sip_uri
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret
VAPI_PHONE_NUMBER_ID=

# ─── TWILIO TELEPHONY & SMS (Server-side credentials) ────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_VOICE_NUMBER=+1XXXXXXXXXX
TWILIO_SMS_FROM_NUMBER=+1XXXXXXXXXX

# ─── HARD DEPLOYMENT SAFETY CEILINGS (Environment Interlocks) ────────────────
# PRODUCTION_CALLS_ENABLED: Hard safety lock (true | false). When false, PSTN calling cannot be activated.
PRODUCTION_CALLS_ENABLED=false

# TWILIO_SMS_MODE: Hard safety lock (disable | enable). When disable, outbound SMS cannot be activated.
TWILIO_SMS_MODE=disable

# ─── PUBLIC WEBHOOK ROUTING & SERVER PORT ────────────────────────────────────
PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev
PORT=3000

# ─── OPTIONAL SERVICING CHANNELS (PoC Placeholders) ──────────────────────────
PAYMENT_PORTAL_BASE_URL=
SECURE_IVR_NUMBER=
HUMAN_QUEUE_DESTINATION=
VAPI_QA_SERVER_URL=

# ─── FRONTEND CONFIGURATION ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000

# ─── MIGRATED & DEPRECATED VARIABLES ─────────────────────────────────────────
# Operational settings (voiceMode, smsEnabled, campaignAutodispatch) are persisted
# in the database table `operational_settings` and controlled from the UI sidebar.
#
# Owner-approved call destinations are persisted in the database table
# `verified_call_destinations` and managed from the Integration Health UI.
